#!/bin/bash
# Claude Code Companion
# Usage: ccc [args...]        - pick an account (who it is signed in as, live usage)
#        ccc N [args...]      - launch directly with Account N
#        ccc N --gpt [args]   - the same, with the GPT models added to /model
#        ccc gpt login        - sign in with ChatGPT, for the GPT models
#        ccc help             - every command: list, add, login, logout, rename,
#                               remove, repair, gpt
#
# Named "ccc", not "cc", because /usr/bin/cc is the C compiler on macOS.

PROFILES_DIR="$HOME/.claude-profiles"
PICKER="$PROFILES_DIR/picker.mjs"
PROFILES_LIB="$PROFILES_DIR/profiles.cjs"
CHATGPT_LIB="$PROFILES_DIR/chatgpt.cjs"
ROUTER="$PROFILES_DIR/router.cjs"

die() {
    printf '  %s\n' "$1" >&2
    exit 1
}

# Every path below runs node. Failing here with a sentence beats letting a
# "command not found" escape from inside a command substitution, which used to
# leave ccc exiting 0 without ever launching anything.
require_runtime() {
    if ! command -v node >/dev/null 2>&1; then
        die "Node.js is required but was not found in PATH. Install it from https://nodejs.org"
    fi
    if [[ ! -f "$PROFILES_LIB" ]]; then
        die "$PROFILES_LIB is missing. Re-run the installer:  bash install.sh"
    fi
}

require_claude() {
    if ! command -v claude >/dev/null 2>&1; then
        die "claude was not found in PATH. Install Claude Code first: https://docs.anthropic.com/en/docs/claude-code"
    fi
}

require_picker() {
    if [[ ! -f "$PICKER" ]]; then
        die "$PICKER is missing. Re-run the installer:  bash install.sh"
    fi
}

require_gpt_runtime() {
    if [[ ! -f "$CHATGPT_LIB" || ! -f "$ROUTER" ]]; then
        die "The GPT support files are missing from $PROFILES_DIR. Re-run the installer:  bash install.sh"
    fi
}

# A command that acts on one account takes its number next: `ccc login 3`.
require_slot() {
    if [[ ! "${2-}" =~ ^-?[0-9]+$ ]]; then
        die "Usage: ccc $1 <number>   (ccc list shows the numbers)"
    fi
}

# Every account shares ONE session history: <profile>/projects is a link to
# ~/.claude/projects, so /resume and the memory dir are common to all accounts.
# A profile that gets created on first login (rather than by `ccc add`) would
# otherwise end up with its own isolated projects dir, so wire the link before
# launching. Anything already at that path is left alone, never clobbered.
ensure_shared_projects() {
    local dir="${1-}"
    [[ -z "$dir" ]] && return 0
    node "$PROFILES_LIB" ensure-shared-projects "$dir" >/dev/null 2>&1
    return 0
}

# One statusline.js serves every account, but each profile opts in through its
# own settings.json. A profile created by logging in for the first time (rather
# than by `ccc add`) never gets that key and silently shows no statusline, so
# wire it before launching. A statusLine that runs something else is left alone,
# and so is a settings.json that does not parse.
ensure_statusline() {
    node "$PROFILES_LIB" ensure-statusline "$1/settings.json" >/dev/null 2>&1
    return 0
}

# Point CLAUDE_CONFIG_DIR at a profile — unset for the default one — with the
# profile wired up before anything runs in it. Takes what resolve-account
# prints: a profile directory, or __DEFAULT__.
use_profile() {
    if [[ "$1" == "__DEFAULT__" ]]; then
        unset CLAUDE_CONFIG_DIR
        ensure_statusline "$HOME/.claude"
    else
        export CLAUDE_CONFIG_DIR="$1"
        ensure_shared_projects "$1"
        ensure_statusline "$1"
    fi
}

# config.json decides; with no entry for this slot, slot 1 is the default
# profile and anything else follows the accountN naming convention.
resolve_slot() {
    node "$PROFILES_LIB" resolve-account "${1#-}"
}

# Start an account. Plain Claude Code, unless the GPT models are wanted: the
# ChatGPT account always, any other account when --gpt is among the arguments
# or `ccc gpt on` set it. Those start through router.cjs, which stays running
# beside Claude Code for as long as it does.
launch() {
    local slot="$1"
    shift
    local args=() want_gpt=() arg target mode permission_flag=--dangerously-skip-permissions
    for arg in "$@"; do
        if [[ "$arg" == "--gpt" ]]; then want_gpt=(--gpt); else args+=("$arg"); fi
    done
    for arg in "${args[@]}"; do
        case "$arg" in
            --) break ;;
            --dangerously-skip-permissions | --permission-mode | --permission-mode=*) permission_flag=; break ;;
        esac
    done
    if [[ -n "$permission_flag" ]]; then
        args=("$permission_flag" "${args[@]}")
    fi

    target=$(resolve_slot "$slot") || exit
    mode=$(node "$PROFILES_LIB" launch-mode "${slot#-}" "${want_gpt[@]}") || exit
    use_profile "$target"
    if [[ "$mode" == claude ]]; then
        exec claude "${args[@]}"
    fi
    require_gpt_runtime
    exec node "$ROUTER" launch --mode "$mode" -- "${args[@]}"
}

case "${1-}" in
    # ── ccc help ───────────────────────────────────────────────
    help | -h | --help)
        require_runtime
        exec node "$PROFILES_LIB" help
        ;;

    # ── ccc list — every account with its live usage ────────────
    list | ls | status)
        require_runtime
        require_picker
        exec node "$PICKER" --list
        ;;

    # ── ccc add [name] — add a new account ──────────────────────
    add)
        shift
        require_runtime
        CUSTOM_NAME="$*"

        NEXT=$(node "$PROFILES_LIB" next-account-number) || exit
        [[ -z "$NEXT" ]] && die "Could not determine the next account number."

        # Prompt for name if not provided
        if [[ -z "$CUSTOM_NAME" ]]; then
            read -rp "  Account name [Account $NEXT]: " CUSTOM_NAME
            [[ -z "$CUSTOM_NAME" ]] && CUSTOM_NAME="Account $NEXT"
        fi

        # The name travels through the environment and the config path never
        # leaves profiles.cjs, so neither can break out into shell or JavaScript
        # syntax.
        ACCT_DIR=$(CC_ACCOUNT_NAME="$CUSTOM_NAME" node "$PROFILES_LIB" add-account "$NEXT") || exit

        echo ""
        echo "  Account $NEXT added!"
        echo ""
        echo "  Name:      $CUSTOM_NAME"
        echo "  Directory:  $ACCT_DIR"
        echo ""
        echo "  Run 'ccc login $NEXT' to sign it in."
        echo ""
        exit 0
        ;;

    # ── ccc rename <n> <name> ───────────────────────────────────
    rename)
        require_slot rename "${2-}"
        [[ -z "${3-}" ]] && die "Usage: ccc rename <number> <new name>"
        require_runtime
        SLOT="${2#-}"
        shift 2
        CC_ACCOUNT_NAME="$*" exec node "$PROFILES_LIB" rename-account "$SLOT"
        ;;

    # ── ccc remove <n> — off the list; its folder is kept ───────
    remove | rm)
        require_slot remove "${2-}"
        require_runtime
        exec node "$PROFILES_LIB" remove-account "${2#-}"
        ;;

    # ── ccc repair [n] ──────────────────────────────────────────
    repair)
        require_runtime
        if [[ -n "${2-}" ]]; then
            require_slot repair "$2"
            exec node "$PROFILES_LIB" repair "${2#-}"
        fi
        exec node "$PROFILES_LIB" repair
        ;;

    # ── ccc login|logout <n> — that slot's own sign-in ──────────
    # Claude Code's for a Claude account; ChatGPT's for the ChatGPT account.
    login | relogin | logout)
        ACTION=login
        [[ "$1" == logout ]] && ACTION=logout
        require_slot "$1" "${2-}"
        SLOT="$2"
        shift 2
        require_runtime

        MODE=$(node "$PROFILES_LIB" launch-mode "${SLOT#-}") || exit
        if [[ "$MODE" == gpt ]]; then
            require_gpt_runtime
            exec node "$CHATGPT_LIB" "$ACTION" "$@"
        fi
        require_claude
        TARGET=$(resolve_slot "$SLOT") || exit
        use_profile "$TARGET"
        exec claude auth "$ACTION" "$@"
        ;;

    # ── ccc gpt … — the GPT models, on your ChatGPT plan ────────
    gpt)
        shift
        require_runtime
        require_gpt_runtime
        case "${1-}" in
            sync)
                require_slot "gpt sync" "${2-}"
                [[ "$#" -ne 2 ]] && die "Usage: ccc gpt sync <number>"
                exec node "$PROFILES_LIB" sync-gpt "${2#-}"
                ;;
            on | off)
                require_slot "gpt $1" "${2-}"
                exec node "$PROFILES_LIB" set-gpt "${2#-}" "$1"
                ;;
        esac
        exec node "$CHATGPT_LIB" "$@"
        ;;
esac

# ── ccc <number> — quick-switch ───────────────────────────────
if [[ "${1-}" =~ ^-?[0-9]+$ ]]; then
    ACCT="$1"
    shift
    require_runtime
    require_claude
    launch "$ACCT" "$@"
fi

# ── ccc — interactive picker ──────────────────────────────────
require_runtime
require_claude
require_picker

SLOT=$(node "$PICKER") || exit

if [[ -z "$SLOT" ]]; then
    exit 0
fi

launch "$SLOT" "$@"
